# Copy to backend/.env and fill in. Never commit .env.

# Neon dashboard -> Connect -> "Pooled connection" string (keep ?sslmode=require)
# For local work use a separate Neon branch, not production: migrations run against this
# database, and a revision the deployed code doesn't know stops the API from starting.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

MAX_UPLOAD_MB=25
CORS_ORIGINS=http://localhost:5173
RUN_WORKER=true

# Delete images (report, thumbnail, findings) not analyzed for this many days; 0 keeps all.
RETENTION_DAYS=90
# Log a warning once the database passes this size; Neon's free tier stops at 512 MB.
STORAGE_WARN_MB=400

# Header with the visitor's real IP for the per-IP upload limit. Cloudflare sets it on Render;
# leave empty to use the connection address instead.
CLIENT_IP_HEADER=cf-connecting-ip

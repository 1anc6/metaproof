# Production only (set in Vercel): where the browser sends API requests.
VITE_API_URL=https://metaproof.onrender.com

# Optional, production only: a Sentry project DSN for error reports. Empty turns them off.
# VITE_SENTRY_DSN=

# Development only: where `npm run dev` forwards /api. Defaults to the local backend.
# API_PROXY=https://metaproof.onrender.com

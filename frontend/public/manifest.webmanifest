{
  "name": "MetaProof",
  "short_name": "MetaProof",
  "description": "Check whether an image looks authentic, edited or AI-generated, and see the evidence.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#030303",
  "theme_color": "#030303",
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        { "name": "image", "accept": ["image/jpeg", "image/png", "image/webp", "image/tiff", "image/heic", "image/heif", ".jpg", ".jpeg", ".png", ".webp", ".tif", ".tiff", ".heic", ".heif"] }
      ]
    }
  }
}
